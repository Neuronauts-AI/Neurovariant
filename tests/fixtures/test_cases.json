      "expected": 1
    },
    {
      "id": "TC-02",
      "group": "assign_label",
      "description": "Açık benign string → 0",
      "function": "assign_label",
      "input": "Benign",
      "expected": 0
    },
    {
      "id": "TC-03",
      "group": "assign_label",
      "description": "Conflicting interpretations → None (EXCLUDE_SIG içeriyor)",
      "function": "assign_label",
      "input": "Conflicting interpretations of pathogenicity",
      "expected": null
    },
    {
      "id": "TC-04",
      "group": "assign_label",
      "description": "Hem pathogenic hem benign varsa → None",
      "function": "assign_label",
      "input": "Pathogenic/Benign",
      "expected": null
    },
    {
      "id": "TC-05",
      "group": "assign_label",
      "description": "None input → None (type guard)",
      "function": "assign_label",
      "input": null,
      "expected": null
    },
    {
      "id": "TC-06",
      "group": "assign_label_with_confidence",
      "description": "Likely pathogenic → label=1, confidence=likely",
      "function": "assign_label_with_confidence",
      "input": "Likely pathogenic",
      "expected": [1, "likely"]
    },
    {
      "id": "TC-07",
      "group": "assign_label_with_confidence",
      "description": "Hard pathogenic → label=1, confidence=hard",
      "function": "assign_label_with_confidence",
      "input": "Pathogenic",
      "expected": [1, "hard"]
    },
    {
