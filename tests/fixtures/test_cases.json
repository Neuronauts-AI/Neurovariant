      "input": "NM_004985.5(KRAS):c.35G>T (p.Gly12Val)",
      "expected": ["G", "T"]
    },
    {
      "id": "TC-09",
      "group": "is_missense",
      "description": "Geçerli missense HGVS → True",
      "function": "is_missense",
      "input": "NM_004985.5(KRAS):c.35G>T (p.Gly12Val)",
      "expected": true
